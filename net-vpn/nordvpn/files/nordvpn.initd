#!/sbin/openrc-run

name="NordVPN daemon"
description="NordVPN CLI connection management daemon"
command="/usr/sbin/nordvpnd"
command_background="yes"
command_user="root:nordvpn"
pidfile="/run/nordvpn/nordvpn.pid"
output_log="/var/log/nordvpn/daemon.log"
error_log="/var/log/nordvpn/daemon.log"

# Do not create interfaces or change firewall/DNS configuration at installation.
# NordVPN receives control over networking only when this service is started.
depend() {
    use net
}

start_pre() {
    checkpath --directory --mode 0750 --owner root:nordvpn /run/nordvpn || return
    checkpath --directory --mode 0750 --owner root:nordvpn /var/log/nordvpn || return
    checkpath --file --mode 0640 --owner root:nordvpn /var/log/nordvpn/daemon.log
}
